      {
        "label": "تأشيرة الجواز السعودي العادي",
        "value": "تُتاح التأشيرة السياحية عند الوصول إلى المنفذ أو إلكترونيًا قبل السفر. المملكة العربية السعودية مدرجة في جدول إدارة الجوازات المصرية.",
        "source": "https://www.moi.gov.eg/passports/foreigners/index2/2",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "مدة الإقامة السياحية",
        "value": "تسمح التأشيرة السياحية المفردة المعتادة بإقامة تصل إلى ٣٠ يومًا. راجع المدة المثبتة في إذن الدخول.",
        "source": "https://egyptconsulate.co.uk/ar/visas/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "رسوم التأشيرة الإلكترونية ورابط الطلب",
        "value": "٣٠ دولارًا أمريكيًا للدخول الواحد، و٦٥ دولارًا للدخول المتعدد. تقدّم من بوابة الحكومة المصرية.",
        "source": "https://visa2egypt.gov.eg/eVisa/FAQ",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
