    "stay": [
      {
        "label": "ثلاثة أحياء أو مناطق لإقامة أولى",
        "value": "غاملا ستان (Gamla Stan) للتاريخ، ونورمالم (Norrmalm) للمواصلات، وسودرمالم (Södermalm) للمقاهي والمتاجر المستقلة.",
