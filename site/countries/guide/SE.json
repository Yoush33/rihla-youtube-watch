    "money": [
      {
        "label": "العملة والدفع",
        "value": "الكرونة السويدية. تدفع غالبًا بالبطاقة في ستوكهولم (Stockholm)، وبعض المحلات لا يقبل الكاش.",
        "source": "https://www.visitstockholm.com/travel-info/travel-tips-for-stockholm-visitors/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "الإكرامية",
        "value": "اختيارية. من المعتاد تقريب المبلغ في المطعم عند الرضا.",
        "source": "https://visitsweden.com/about-sweden/tipping/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "تكلفة اليوم للفرد — اقتصادي",
        "value": "حوالي 266 ريالًا سعوديًا في السويد للإقامة والطعام والتنقل والأنشطة. تقدير مبني على إنفاق مسافرين، دون طيران الرياض.",
        "source": "https://www.budgetyourtrip.com/sweden",
