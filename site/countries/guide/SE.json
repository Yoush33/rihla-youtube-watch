    "safety": [
      {
        "label": "أماكن تستدعي الانتباه وأساليب السرقة",
        "value": "يستهدف النشالون السياح في المدن الكبرى. احفظ الجواز والبطاقات منفصلة أثناء التنقل.",
        "source": "https://www.gov.uk/foreign-travel-advice/sweden/safety-and-security",
