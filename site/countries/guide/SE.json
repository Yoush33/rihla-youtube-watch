    "connect": [
      {
        "label": "شريحة للزائر وسعر تقريبي",
        "value": "كومفيك توفر خطًا مسبق الدفع، يتطلب تسجيل الهوية. مثال أسعارها 59 كرونة مقابل غيغابايت واحدة لمدة 7 أيام.",
        "source": "https://www.comviq.se/en/prepaid",
        "checked": "2026-11-27",
        "status": "estimate"
      },
      {
        "label": "تطبيق نقل",
        "value": "أوبر (Uber) وبولت (Bolt) يعملان في ستوكهولم (Stockholm).",
        "source": "https://www.visitstockholm.com/travel-info/handy-apps/",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "transport": [
      {
        "label": "من المطار إلى المدينة",
        "value": "من مطار أرلاندا (Arlanda) اختر قطار أرلاندا إكسبريس أو حافلة المطار إلى ستوكهولم (Stockholm).",
        "source": "https://www.visitstockholm.com/travel-info/airport-transfer/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "بين المدن والجزر",
        "value": "شبكة قطارات المسافات الطويلة تربط ستوكهولم (Stockholm) بمدن في أنحاء السويد.",
        "source": "https://visitsweden.com/where-to-go/middle-sweden/stockholm/",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "food": [
      {
        "label": "الحلال والصلاة",
        "value": "مسجد ستوكهولم (Stockholm Mosque) في سودرمالم (Södermalm)، ومواعيد الزيارة منشورة على موقع المسجد.",
        "source": "https://stockholmsmoske.se/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "ثلاثة أطباق محلية",
        "value": "كرات اللحم السويدية بعد التحقق من المكونات، والرنجة المخمّرة، ولفائف القرفة.",
        "source": "https://visitsweden.com/what-to-do/food-drink/swedish-kitchen/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "توفر الحلال",
        "value": "يوفر دليل ميشلان مرشحًا للمطاعم التي تقدم خيارات حلال في منطقة ستوكهولم (Stockholm). اسأل عن الطبق عند الحجز.",
        "source": "https://guide.michelin.com/en/se/stockholm-region/restaurants",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "customs": [
      {
        "label": "اللبس والتصرف في الأماكن العامة",
        "value": "احترم الدور، وابحث عن آلة أرقام الانتظار في المتاجر والخدمات التي تستخدمها.",
