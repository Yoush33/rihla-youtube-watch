        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "الدفع والإكرامية",
        "value": "الإكرامية اختيارية في معظم المطاعم، ولا تُتوقع عادةً في أكشاك طعام الشارع. راجع رسوم الخدمة في الفنادق.",
        "source": "https://www.vietnamtourism.com/en/tipping-in-vietnam-2026-when-it-s-insulting-when-it-s-expected",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "ميزانية الفرد اليومية بالريال",
        "value": "اقتصادي نحو ٩٤ ريالًا ومتوسط نحو ٢٤٨ ريالًا، من عينة لمصروفات الإقامة والطعام والتنقل والأنشطة.",
        "source": "https://www.budgetyourtrip.com/Vietnam",
        "checked": "2026-11-27",
        "status": "estimate"
      }
    ],
    "connect": [
      {
        "label": "الشريحة أو الشريحة الإلكترونية",
        "value": "مثال باقة الزائر تي آر ١٠٩، نحو ١٠٩ آلاف دونغ مقابل ٤ غيغابايت يوميًا لمدة ٢٠ يومًا.",
        "source": "https://vietnamonabudget.com/vietnam-sim-card-esim",
        "checked": "2026-11-27",
        "status": "estimate"
      },
      {
        "label": "تطبيق النقل",
        "value": "غراب تاكسي لحجز السيارة ورؤية تفاصيل المشوار.",
        "source": "https://www.grab.com/vn/en/transport/taxi/",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "transport": [
      {
        "label": "المطار إلى المدينة",
        "value": "ينشر مطار نوي باي (Noi Bai) في هانوي (Hanoi) مواقع الحافلات وسيارات الأجرة عند مباني الركاب.",
        "source": "https://noibaiairport.vn/en/phuong-tien-van-chuyen-cong-cong-nid1.html",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "بين المدن",
        "value": "القطار والحافلات والطيران الداخلي خيارات للمسافات الطويلة. قارن زمن الرحلة خصوصًا بين الشمال والجنوب.",
        "source": "https://www.vietnamtourism.com/en/transport",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "food": [
      {
        "label": "الحلال",
        "value": "تنشر هيئة السياحة مطاعم حلال في مدن منها هانوي (Hanoi)، ومدينة هو تشي منه (Ho Chi Minh City)، ودا نانغ (Da Nang).",
        "source": "https://vietnam.travel/things-to-do/ultimate-recommendation-halal-food-vietnam/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "الصلاة",
        "value": "جامع النور في شارع هانغ لووك (Hang Luoc) في الحي القديم بهانوي (Hanoi).",
        "source": "https://religion.vn/daily-news/the-muslim-mosque-in-hanoi-postY1RdXeORZQ.html",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "ثلاثة أطباق محلية",
        "value": "فو بالنودلز، وبان مي بالخبز، ولفائف الربيع. اسأل عن لحم الخنزير والمرق حتى لو بدت الحشوة نباتية.",
        "source": "https://vietnam.travel/things-to-do/21-must-try-vietnamese-dishes/",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "customs": [
      {
        "label": "اللبس والسلوك",
        "value": "احتشم في المعابد واخلع الحذاء حيث تطلب اللوحات. استأذن قبل تصوير الأشخاص.",
        "source": "https://vietnam.travel/sites/default/files/2020-10/Beginner%27s%20Guide%20to%20Vietnam%20Now.pdf",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "إغلاق المتاجر",
        "value": "كثير من متاجر المدن تفتح تقريبًا ٨:٣٠ صباحًا وتغلق ٩–١٠ مساءً، ويعمل عدد منها يوم الأحد.",
        "source": "https://www.britishcouncil.vn/sites/default/files/vietnam_visitors_notes.pdf",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "safety": [
      {
        "label": "الطوارئ",
        "value": "الشرطة ١١٣ والإطفاء ١١٤ والإسعاف ١١٥. الرد عادةً بالفيتنامية.",
        "source": "https://www.gov.uk/foreign-travel-advice/vietnam/getting-help",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "السرقة والاحتيال",
        "value": "خطف الهواتف والحقائب من دراجات نارية خطر معروف. ابتعد بالجوال عن حافة الطريق.",
        "source": "https://www.gov.uk/foreign-travel-advice/vietnam/safety-and-security",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "الأماكن التي تستدعي الحذر",
        "value": "انتبه أكثر عند التقاط الصور أو استخدام الهاتف في الشوارع المزدحمة بالمدن السياحية.",
        "source": "https://www.gov.uk/foreign-travel-advice/vietnam/safety-and-security",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "stay": [
      {
        "label": "مناطق السكن وأسباب الاختيار",
        "value": "في هانوي (Hanoi)، الحي القديم (Old Quarter) للطعام والأسواق، والحي الفرنسي (French Quarter) لهدوء نسبي، وتاي هو (Tay Ho) للسكن قرب البحيرة والإقامات الأطول.",
        "source": "https://www.vietnambyregion.com/north/where-to-stay-hanoi/",
        "checked": "2026-11-27",
        "status": "recommendation"
      }
    ],
