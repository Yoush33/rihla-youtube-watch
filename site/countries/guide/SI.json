    "stay": [
      {
        "label": "مناطق السكن وأسباب الاختيار",
        "value": "في ليوبليانا (Ljubljana)، البلدة القديمة (Old Town) للمشي إلى المعالم، وترنوفو (Trnovo) لهدوء الضفة، وشيشكا (Šiška) للسكن خارج المركز.",
        "source": "https://visitslovenia.com/slovenia/travel-guides/places-of-interest/what-are-the-best-neighborhoods-in-ljubljana",
        "checked": "2026-11-27",
        "status": "recommendation"
      }
    ],
    "cities": [
      {
        "label": "مسار الزيارة ومدة كل محطة",
        "value": "مسار من ثلاثة أيام، يوم في ليوبليانا (Ljubljana) للقلعة والسوق، ويوم في بليد (Bled) للبحيرة، ويوم في بوستوينا (Postojna) للكهف وقلعة بريدجاما (Predjama).",
        "source": "https://visitslovenia.com/slovenia/travel-guides/places-of-interest/slovenia-in-3-days",
        "checked": "2026-11-27",
        "status": "recommendation"
      }
