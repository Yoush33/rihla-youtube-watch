        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "الرسوم",
        "value": "الرسم الأساسي للبالغ ٩٠ يورو. قد يضاف رسم خدمة عند التقديم عبر وسيط.",
        "source": "https://home-affairs.ec.europa.eu/policies/schengen/schengen-visas/applying-schengen-visa_en",
        "checked": "2026-11-27",
        "status": "confirmed"
