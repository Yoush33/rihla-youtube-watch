{
  "code": "SC",
  "sections": {
    "entry": [
      {
        "label": "دخول حامل الجواز السعودي العادي",
        "value": "لا تأشيرة للسائح، ويلزم تصريح السفر الإلكتروني قبل الوصول. يصدر تصريح الزيارة عند الوصول بعد استيفاء الشروط.",
        "source": "https://mfa.gov.sc/travelling-to-seychelles/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "المدة الأولية",
        "value": "تصل إلى ثلاثة أشهر وفق قرار الهجرة. من شروط التصريح حجز سكن مؤكد وتذكرة عودة أو متابعة وإثبات المقدرة المالية.",
        "source": "https://www.ics.gov.sc/permits/visitors-permit",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "رسوم التصريح الإلكتروني",
        "value": "10.90 يورو للمعالجة العادية.",
        "source": "https://mfa.gov.sc/travelling-to-seychelles/",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "money": [
      {
        "label": "العملة والدفع",
        "value": "الروبية السيشلية. تُقبل البطاقات في المنشآت الكبيرة ويفيد النقد للأسواق والمتاجر الصغيرة.",
        "source": "https://seychelles.com/blog-details/2001/highlights/travel-tips-being-seychelles",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "الإكرامية",
        "value": "غالبًا تتضمن الفاتورة رسم الخدمة. ترك 5–10٪ للخدمة المميزة سخي واختياري.",
        "source": "https://www.expertafrica.com/seychelles/info/tipping-in-seychelles",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "تكلفة اليوم للفرد — اقتصادي",
        "value": "حوالي 386 ريالًا سعوديًا في سيشل للإقامة والطعام والتنقل والأنشطة. تقدير مبني على إنفاق مسافرين، دون طيران الرياض.",
        "source": "https://www.budgetyourtrip.com/seychelles",
        "checked": "2026-11-27",
        "fxSource": "https://www.sama.gov.sa/en-US/Currency/FinExc/pages/currency.aspx",
        "status": "estimate"
      },
      {
        "label": "تكلفة اليوم للفرد — متوسط",
        "value": "حوالي 881 ريالًا سعوديًا في سيشل للإقامة والطعام والتنقل والأنشطة. تقدير مبني على إنفاق مسافرين، دون طيران الرياض.",
        "source": "https://www.budgetyourtrip.com/seychelles",
        "checked": "2026-11-27",
        "fxSource": "https://www.sama.gov.sa/en-US/Currency/FinExc/pages/currency.aspx",
        "status": "estimate"
      }
    ],
    "connect": [
      {
        "label": "شريحة للزائر وسعر تقريبي",
        "value": "باقة زائر مقابل 588 روبية سيشلية تشمل 10 غيغابايت لمدة 21 يومًا بحسب عرض الناقل.",
        "source": "https://www.airseychelles.com/portals/silhouette/2025/Silhouette_Oct-Dec-2025.pdf",
        "checked": "2026-11-27",
        "status": "estimate"
      },
      {
        "label": "تطبيق نقل",
        "value": "سي تاكسي (SeyTaxi) خيار محلي. تأكد من نطاق الخدمة في جزيرتك.",
        "source": "https://www.agoda.com/travel-guides/seychelles/seychelles-transportation-guide-buses-ferries-taxis-and-car-rentals/",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "transport": [
      {
        "label": "من المطار إلى المدينة",
        "value": "من مطار سيشل الدولي في ماهيه (Mahé) توجد سيارات أجرة خارج صالة الوصول وحافلات على الطريق قرب المطار.",
        "source": "https://seychellesairports.sc/travel-connections/transportation",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "بين المدن والجزر",
        "value": "تخدم حافلات النقل العام جزيرتي ماهيه (Mahé) وبرالين (Praslin). للتنقل بين الجزر تتوفر العبّارات.",
        "source": "https://www.egov.sc/PressRoom/MyCitizen/PTransport.aspx",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "food": [
      {
        "label": "الحلال والصلاة",
        "value": "الخيار الحلال أسهل قرب مسجد فيكتوريا (Victoria Mosque). خارج العاصمة تحقق من مصدر اللحوم وطريقة إعداد المأكولات البحرية.",
        "source": "https://www.rahhala.sa/en/country/seychelles",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "ثلاثة أطباق محلية",
        "value": "كاري السمك، والسمك المشوي، وحساء المحار تيك تيك.",
        "source": "https://www.untourism.int/africa/african-gastronomy/seychelles",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "customs": [
      {
        "label": "اللبس والتصرف في الأماكن العامة",
        "value": "خصص ملابس البحر للشاطئ، وغطِّ جسمك في المتاجر والمطاعم والكنائس.",
        "source": "https://bestinseychelles.com/customs-and-traditions/",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "إغلاق المحلات",
        "value": "تغلق محلات تجزئة عديدة الأحد والإجازات الرسمية، ويعمل بعض متاجر الغذاء لساعات صباحية أقصر.",
        "source": "https://seychelles.com/blog-details/2001/highlights/travel-tips-being-seychelles",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "safety": [
      {
        "label": "أماكن تستدعي الانتباه وأساليب السرقة",
        "value": "سُجلت سرقات من السيارات والشواطئ ومسارات المشي. لا تترك الحقيبة في سيارة مركونة أو على الشاطئ.",
        "source": "https://www.gov.uk/foreign-travel-advice/seychelles/safety-and-security",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "رقم الطوارئ",
        "value": "999 للطوارئ.",
        "source": "https://www.gov.uk/foreign-travel-advice/seychelles/getting-help",
        "checked": "2026-11-27",
        "status": "confirmed"
      }
    ],
    "stay": [
      {
        "label": "ثلاثة أحياء أو مناطق لإقامة أولى",
        "value": "بو فالون (Beau Vallon) للسكن على الشاطئ، وفيكتوريا (Victoria) للأسواق والمتاحف، وأنس رويال (Anse Royale) لشواطئ الساحل الجنوبي الشرقي.",
        "source": "https://seychelles.com/blog-details/13554/highlights/seychelles-districts-complete-guide-visitors-and-locals",
        "checked": "2026-11-27",
        "status": "recommendation"
      }
    ],
    "cities": [
      {
        "label": "مدن ومدد مقترحة لزيارة أولى",
        "value": "فيكتوريا (Victoria) في ماهيه (Mahé)، ثم جزيرتا برالين (Praslin) ولا ديغ (La Digue). تقترح هيئة السياحة 10–14 يومًا للجزر الثلاث مجتمعة مع عدة أيام لكل جزيرة.",
        "source": "https://www.seychelles.com/blog-details/1862/highlights/how-many-days-should-you-plan-seychelles-holiday",
        "checked": "2026-11-27",
        "status": "recommendation"
      },
      {
        "label": "توزيع الأيام بين الجزر",
        "value": "مثال لعشرة أيام: ثلاثة أيام في ماهيه (Mahé)، والأيام 4 إلى 6 في برالين (Praslin)، وثلاث ليالٍ في لا ديغ (La Digue) مع هامش للعودة.",
        "source": "https://bestinseychelles.com/10-days-in-seychelles/",
        "checked": "2026-11-27",
        "status": "recommendation"
      }
    ],
