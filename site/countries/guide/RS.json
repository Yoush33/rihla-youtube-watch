  "sections": {
    "entry": [
      {
        "label": "دخول حامل الجواز السعودي العادي",
        "value": "الجواز السعودي العادي يحتاج تأشيرة قبل السفر ما لم ينطبق أحد الإعفاءات.",
        "source": "https://www.mfa.gov.rs/en/citizens/travel-serbia/visa-regime/saudijska-arabija",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "استثناء قد ينطبق",
        "value": "يجوز الدخول بتأشيرة سارية لشنغن أو بريطانيا أو إحدى دول الاتحاد الأوروبي أو الولايات المتحدة، أو إقامة سارية في شنغن أو الاتحاد الأوروبي أو الولايات المتحدة. الحد 90 يومًا في ستة أشهر وضمن صلاحية الوثيقة.",
        "source": "https://mfa.rs/en/citizens/travel-serbia/visa-requirements",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "مدة تأشيرة الزيارة القصيرة",
        "value": "حتى 90 يومًا خلال 180 يومًا.",
        "source": "https://welcometoserbia.gov.rs/short-term-visa-c-visa-purpose-of-stay-travel-for-tourist-or-private-purposes",
        "checked": "2026-11-27",
        "status": "confirmed"
      },
      {
        "label": "رسم طلب التأشيرة",
        "value": "90 يورو لتأشيرة الزيارة القصيرة.",
